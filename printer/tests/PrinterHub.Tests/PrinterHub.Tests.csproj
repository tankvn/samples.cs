<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Test không phụ thuộc NuGet (mini test runner) để chạy được cả ở môi trường offline.
    Chạy: dotnet run (trong thư mục tests/PrinterHub.Tests), có thể thêm bộ lọc tên test
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PrinterHub.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PrinterHub.Core\PrinterHub.Core.csproj" />
    <ProjectReference Include="..\..\src\PrinterHub.Languages\PrinterHub.Languages.csproj" />
    <ProjectReference Include="..\..\src\PrinterHub.Transports\PrinterHub.Transports.csproj" />
    <ProjectReference Include="..\..\tools\PrinterHub.Simulator\PrinterHub.Simulator.csproj" />
  </ItemGroup>
</Project>
